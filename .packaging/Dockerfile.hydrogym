# Dockerfile with HydroGym included
#   --> highly unstable for now.

FROM lpaehler/hydrogym-env:stable

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

USER firedrake
WORKDIR /home/firedrake

# Activation of the virtual environment
RUN bash -c "source firedrake/bin/activate"

# Clone HydroGym
RUN bash -c "git clone https://github.com/dynamicslab/hydrogym.git"

# Install the locked dependencies additively into the existing Firedrake
# environment, then install HydroGym without pruning Firedrake itself.
RUN bash -c "cd hydrogym && ./scripts/bootstrap_firedrake.sh"
