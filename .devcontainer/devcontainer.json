{
  "name": "MAIA + HydroGym Modular (NVHPC 26.5)",
  "build": {
    "dockerfile": "base/Dockerfile.base",
    "args": {
      "PSTL_PRESET": "ada",
      "BUILD_TYPE": "production"
    }
  },
  "features": {
    "./features/maia-gpu": {
      "pstlPreset": "ada",
      "buildType": "production"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "nvidia.nsight-vscode-edition"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/opt/nvidia/hpc_sdk/Linux_x86_64/26.5/compilers/bin/nvc++",
        "C_Cpp.default.compileCommands": "${workspaceFolder}/wipmaiaml/build_nvhpc_production/compile_commands.json",
        "C_Cpp.intelliSenseEngine": "default",
        "cmake.configureOnOpen": false,
        "cmake.automaticReconfigure": false,
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  },
  "runArgs": [
    "--gpus=all",
    "--net=host",
    "--ipc=host",
    "--hostname=LocalGPU",
    "--cap-add=SYS_ADMIN"
  ],
  "workspaceMount": "source=/home/christian/maia_solver,target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "root"
}