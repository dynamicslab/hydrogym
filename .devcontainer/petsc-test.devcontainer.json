{
  "name": "TEST: petsc only",
  "build": {
    "dockerfile": "base/Dockerfile.base",
    "args": {
      "PSTL_PRESET": "ada",
      "BUILD_TYPE": "production"
    }
  },
  "features": {
    "./features/petsc": {}
  },
  "runArgs": [
    "--gpus=all",
    "--net=host",
    "--ipc=host",
    "--hostname=LocalGPU",
    "--cap-add=SYS_ADMIN"
  ],
  "workspaceMount": "source=/home/christian/maia_solver,target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "root"
}
