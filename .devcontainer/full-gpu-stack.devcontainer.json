{
  "name": "FULL: GPU stack (maia-gpu + jax-gpu)",
  "build": {
    "dockerfile": "base/Dockerfile.base",
    // NOTE: PSTL_PRESET/BUILD_TYPE here are currently unused - Dockerfile.base
    // declares no matching ARG, so these are no-ops. The GPU architecture is
    // actually set by features["./features/maia-gpu"].pstlPreset below.
    "args": {
      "PSTL_PRESET": "ada",
      "BUILD_TYPE": "production"
    }
  },
  "features": {
    "./features/maia-gpu": {
      // pstlPreset is hardcoded to "ada" (RTX 40-series / Ada Lovelace) -
      // change this to match YOUR OWN GPU before building, or the solver
      // will compile for the wrong architecture. See .devcontainer/README.md
      // for the full list of valid values and how to pick yours.
      "pstlPreset": "ada",
      "buildType": "production"
    },
    "./features/hydrogym-gpu": {
      // "jax" alone doesn't cover jaxfluids's own deps (pyvista, gitpython,
      // h5py, optax - see pyproject.toml's separate [tool.poetry.extras]
      // jax vs jaxfluids groups) even though test_gpu_solvers.sh's
      // jaxfluids test expects them to be present.
      "hydrogymExtras": "maia,jax,jaxfluids"
    }
  },
  "runArgs": [
    "--gpus=all",
    "--net=host",
    "--ipc=host",
    "--hostname=LocalGPU",
    "--cap-add=SYS_ADMIN"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "root"
}
